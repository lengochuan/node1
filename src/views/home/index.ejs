<!DOCTYPE html>
<html>
<head>
    <title>Trang web đầu tiên của tôi</title>
</head>
<body>
    <h1>Xin chào, đây là trang web đầu tiên của tôi!</h1>
    <p>
        <% if( dUser && dUser.username && dUser.username != ''){ %>

            <div class="title">
              Xin chào, <b><%= dUser.username %></b>
              <em class="far fa-chevron-down">
              </em>
            </div>
            <div class="depth-wrap wrapper">
              <ul>
               
                <li>
                  <a target="_self" href="/signout" title="Thoát">Thoát</a>
                </li>
              </ul>
            </div>
          <% } else{ %>  
            <a target="_self" href="/signin" title="Đăng nhập">Đăng nhập</a>
            <a target="_self" href="/signup" title="Đăng nhập">Đăng ký</a>
         <% } %>

    </p>
</body>
</html>